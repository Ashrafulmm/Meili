# Supabase configuration
# Get these values from: https://supabase.com/dashboard/your-project/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-starts-with-eyJ...

# NOTE: NEVER put the service_role key in VITE_ variables!
# The service_role key bypasses all security and must stay server-side only.
